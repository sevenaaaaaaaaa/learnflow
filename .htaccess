Options -Indexes
DirectoryIndex admin/login.php index.php

RewriteEngine On
RewriteBase /learnflow/

# FastCGI 下把 Authorization 头透传给 PHP（Bearer Token 鉴权）
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^data(/|$) - [F,L]
RewriteRule ^uploads(/|$) - [F,L]
RewriteRule ^(includes|lib)(/|$) - [F,L]
RewriteRule ^(\.env|\.git) - [F,L]

<FilesMatch "\.(json|lock|log|cache|md)$">
  Require all denied
</FilesMatch>
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^$ admin/login.php [L,QSA]
RewriteRule ^courses/?$ courses.php [L,QSA]
RewriteRule ^camp/?$ camp.php [L,QSA]
RewriteRule ^camp/([^/]+)/?$ camp.php?slug=$1 [L,QSA]
RewriteRule ^file/?$ file.php [L,QSA]
RewriteRule ^dashboard/?$ dashboard.php [L,QSA]
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^join/?$ join.php [L,QSA]
RewriteRule ^account/?$ account.php [L,QSA]
RewriteRule ^notifications/?$ notifications.php [L,QSA]
RewriteRule ^forgot-password/?$ forgot-password.php [L,QSA]
RewriteRule ^reset-password/?$ reset-password.php [L,QSA]
RewriteRule ^terms/?$ terms.php [L,QSA]
RewriteRule ^privacy/?$ privacy.php [L,QSA]
RewriteRule ^membership/?$ membership.php [L,QSA]
RewriteRule ^robots\.txt$ robots.php [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^manifest\.webmanifest$ manifest.php [L,QSA]
RewriteRule ^sw\.js$ sw.php [L,QSA]
RewriteRule ^mcp/?$ mcp.php [L,QSA]
RewriteRule ^api/v1/?$ api/v1.php [L,QSA]
RewriteRule ^course/([^/]+)/?$ course.php?slug=$1 [L,QSA]
RewriteRule ^learn/([^/]+)/?$ learn.php?slug=$1 [L,QSA]
RewriteRule ^quiz/([^/]+)/?$ quiz.php?slug=$1 [L,QSA]
RewriteRule ^certificate/([^/]+)/?$ certificate.php?no=$1 [L,QSA]
RewriteRule ^certificate/?$ certificate.php [L,QSA]

RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/([a-z0-9-]+)/?$ admin/$1.php [L,QSA]
